{
  "name": "sntss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "positions:test": "node --import tsx scripts/tests/test-position-regression.ts",
    "pdf:test": "tsx scripts/tests/test-parsers.ts",
    "pdf:test:escalafon": "tsx scripts/tests/test-escalafon-parsers.ts",
    "pdf:test:nuevo-ingreso": "tsx scripts/tests/test-nuevo-ingreso.ts",
    "contract-chat:index": "tsx scripts/ops/build-contract-chat-index.ts",
    "contract-chat:eval": "tsx scripts/tests/evaluate-contract-chat.ts",
    "bench:chat": "tsx scripts/tests/evaluate-contract-chat.ts && tsx scripts/tests/evaluate-contract-responses.ts",
    "users:backfill-search": "tsx scripts/ops/backfill-user-search-fields.ts"
  },
  "dependencies": {
